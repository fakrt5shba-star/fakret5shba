{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "product", "value": "(?<pid>[A-Za-z0-9_-]+)" }],
      "destination": "/product?id=:pid",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/meta-catalog.csv", "destination": "/api/meta-catalog" },
    {
      "source": "/product",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|meta-externalagent|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Snapchat|redditbot|Viber).*" }],
      "destination": "/api/product-og"
    },
    { "source": "/product", "destination": "/product-page" }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    }
  ]
}
